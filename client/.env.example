VITE_GOOGLE_MAPS_API_KEY = # Your Google Maps API key here

# Firebase configuration (visit https://firebase.google.com/ to create a free Firebase project)
VITE_FIREBASE_API_KEY = # Your Firebase API key here
VITE_FIREBASE_AUTH_DOMAIN = # Your Firebase Auth domain here
VITE_FIREBASE_PROJECT_ID = # Your Firebase project ID here
VITE_FIREBASE_STORAGE_BUCKET = # Your Firebase Storage bucket here
VITE_FIREBASE_USER_AVATAR_BUCKET = smartwatch-user-avatar # Your Firebase Storage bucket for user avatars
VITE_FIREBASE_PRODUCT_IMAGE_BUCKET = smartwatch-product-image # Your Firebase Storage bucket for product images
VITE_FIREBASE_RETURN_IMAGE_BUCKET = smartwatch-return-image # Your Firebase Storage bucket for return images
VITE_FIREBASE_MESSAGING_SENDER_ID = # Your Firebase Messaging sender ID here
VITE_FIREBASE_APP_ID = # Your Firebase App ID here
VITE_FIREBASE_MEASUREMENT_ID = # Your Firebase Measurement ID here

# Stripe configuration (visit https://stripe.com/ to create a free Stripe account)
